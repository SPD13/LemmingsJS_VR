# IDEs
.idea/
.vscode/
.DS_Store
*.iml
**/.project
**/.settings
*.code-workspace

# package managers
bower_components/
node_modules/

# Level packs: everything under levels/ is a drop-in and stays out of git -
# the classic games and the generated index included (see README "Levels
# and assets": the setup page installs them into the browser).
levels/*
!levels/README.md

# NeoLemmix assets (styles, panel/mask graphics, sound effects, music packs):
# the NeoLemmix zip and the styles package unpacked into neolemmix/, not
# committed - see neolemmix/README.md.
neolemmix/*
!neolemmix/README.md

# NeoLemmix source, fetched for reference (see README) - not committed
Doc/neolemmix-src/

# scratch: screenshots, test downloads and other throwaways
tmp/

# the release tool (builder/): kept out of git, run from a local copy
builder/
