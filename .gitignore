# IDEs
.idea/
.vscode/
.DS_Store
*.iml
**/.project
**/.settings
*.code-workspace

# package managers
bower_components/
node_modules/

# Level packs: everything under levels/ is a drop-in and stays out of git,
# except the two classic games the repo has always carried and the generated
# index (see README "Levels and assets" for where packs come from).
levels/*
!levels/lemmings/
!levels/lemmings_ohNo/
!levels/index.json
!levels/README.md

# NeoLemmix assets (styles, panel/mask graphics, sound effects, music packs):
# the NeoLemmix zip and the styles package unpacked into neolemmix/, not
# committed - see neolemmix/README.md.
neolemmix/*
!neolemmix/README.md

# NeoLemmix source, fetched for reference (see README) - not committed
Doc/neolemmix-src/

# scratch: screenshots and other throwaways
tmp/
